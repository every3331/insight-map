# 洞见 · 跨学段错题地图 — 环境变量模板
# 用法：复制本文件为 .env.local（Next.js 版）或直接照着设成系统环境变量（零依赖版）
# 说明：所有变量都只在【服务端】使用；前端永远拿不到 Key（接口只返回掩码）

# ── 必填（想用真模型时）─────────────────────────────────
# 任何 OpenAI 兼容网关的 Key。留空则自动使用内置本地引擎，功能不受影响。
AGENT_API_KEY=sk-在这里填你的key

# ── 选填 ──────────────────────────────────────────────
# 网关地址（末尾通常带 /v1）。默认 DeepSeek。
AGENT_BASE_URL=https://api.deepseek.com/v1

# 模型名。换成网关支持的任意模型即可，无需改代码。
AGENT_MODEL=deepseek-chat

# 零依赖后端的监听端口（默认 5173）。被占用时改这里。
PORT=5173
